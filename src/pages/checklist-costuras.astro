<script is:inline>
  // Las 15 preguntas reales del checklist, agrupadas en los 5 quiebres.
  var QUIZ_QUESTIONS = [
    { cat: 'Canal', text: 'Un cliente puede cambiar de canal sin repetir su problema.' },
    { cat: 'Canal', text: 'Todos los canales de atención comparten el mismo historial de conversación.' },
    { cat: 'Canal', text: 'Existe una sola fuente de información sobre el estado de cada caso, visible desde cualquier canal.' },
    { cat: 'Datos', text: 'El CRM, el ERP y el sistema de soporte comparten información en tiempo real (no por planilla).' },
    { cat: 'Datos', text: 'Cualquier persona del equipo puede reconstruir el historial completo de un cliente en menos de un minuto.' },
    { cat: 'Datos', text: 'Existe un responsable claro de la calidad de los datos de cliente (no "todos" ni "nadie").' },
    { cat: 'Automatización', text: 'Existe un mapa único y actualizado del viaje del cliente de punta a punta.' },
    { cat: 'Automatización', text: 'Antes de automatizar un proceso, alguien audita si ese proceso debería existir en su forma actual.' },
    { cat: 'Automatización', text: 'Los bots y flujos de distintas áreas fueron diseñados para conversar entre sí, no de forma aislada.' },
    { cat: 'Adopción de IA', text: 'Existe un criterio o política compartida sobre cómo y cuándo usar IA en procesos con clientes.' },
    { cat: 'Adopción de IA', text: 'Los equipos que usan IA recibieron formación básica, no solo acceso a la herramienta.' },
    { cat: 'Adopción de IA', text: 'Hay forma de medir si el uso de IA mejora o empeora la experiencia del cliente (no es solo intuición).' },
    { cat: 'Experiencia del empleado', text: 'Un colaborador nuevo puede resolver el caso más común sin ayuda, en su primera semana.' },
    { cat: 'Experiencia del empleado', text: 'Las herramientas internas están diseñadas pensando en quien las usa, no solo en quien las compró.' },
    { cat: 'Experiencia del empleado', text: 'Existe un canal formal para que los equipos reporten fricción en sus propias herramientas.' }
  ];

  var quizAnswers = [];
  var quizIndex = 0;

  function quizStart() {
    document.getElementById('quiz-intro').style.display = 'none';
    document.getElementById('quiz-questions').style.display = 'block';
    quizIndex = 0;
    quizAnswers = [];
    quizRender();
  }

  var CAT_ICONS = {
    'Canal': 'ph-chat-circle-dots',
    'Datos': 'ph-database',
    'Automatización': 'ph-gear',
    'Adopción de IA': 'ph-brain',
    'Experiencia del empleado': 'ph-users-three'
  };

  function quizRender() {
    var q = QUIZ_QUESTIONS[quizIndex];
    document.getElementById('quiz-progress-label').textContent = 'Pregunta ' + (quizIndex + 1) + ' de ' + QUIZ_QUESTIONS.length;
    document.getElementById('quiz-progress-cat-text').textContent = q.cat;
    document.getElementById('quiz-progress-cat-icon').className = 'ph-fill ' + (CAT_ICONS[q.cat] || 'ph-circle');
    document.getElementById('quiz-progress-fill').style.width = (quizIndex / QUIZ_QUESTIONS.length * 100) + '%';
    document.getElementById('quiz-question-text').textContent = q.text;
    document.getElementById('quiz-back-btn').disabled = (quizIndex === 0);
  }

  function quizAnswer(value) {
    quizAnswers[quizIndex] = value;
    quizIndex++;
    if (quizIndex >= QUIZ_QUESTIONS.length) {
      quizShowResult();
    } else {
      quizRender();
    }
  }

  function quizBack() {
    if (quizIndex === 0) return;
    quizIndex--;
    quizRender();
  }

  function quizShowResult() {
    document.getElementById('quiz-questions').style.display = 'none';
    document.getElementById('quiz-progress-fill').style.width = '100%';

    var score = quizAnswers.reduce(function (sum, v) { return sum + v; }, 0);
    document.getElementById('quiz-score').textContent = score + '/30';

    var tier, desc;
    if (score <= 12) {
      tier = 'Fricción estructural';
      desc = 'Tu empresa está perdiendo clientes y no sabes por qué. No automatices nada sin diagnosticar dónde se producen las fricciones.';
    } else if (score <= 22) {
      tier = 'Quiebres activos';
      desc = 'Algo no está conectado, y te está costando clientes sin que lo notes. Necesitas saber exactamente dónde.';
    } else {
      tier = 'Operación orquestada';
      desc = 'Tu operación funciona mejor que la mayoría. El peligro ahora es no ver la próxima grieta a tiempo.';
    }
    document.getElementById('quiz-tier').textContent = tier;
    document.getElementById('quiz-tier-desc').textContent = desc;

    document.getElementById('quiz-result').style.display = 'block';
  }

  function quizShowForm() {
    document.getElementById('quiz-result').style.display = 'none';
    document.getElementById('quiz-form-view').style.display = 'block';
    // El envío (script al final del <body>) toma window.quizAnswers y lo manda
    // como `respuestas` en el POST, para que el informe sea específico a estas 15 respuestas.
  }
</script>

