    [whole, dot, s1, s2, ghost, c1, c2, ring].forEach(function (x) { g.appendChild(x); });
    svg.appendChild(g);
    return { whole: whole, dot: dot, s1: s1, s2: s2, ghost: ghost, c1: c1, c2: c2, ring: ring };
  });

  // ===== Fotograma de cierre: radios a Cliente (misma curva/degradado que el resto) + etiqueta =====
  var spokePaths = EDGES.map(function (e, i) {
    var g = e.g;
    var path = mk('path', {
      d: 'M ' + g.ax + ',' + g.ay + ' Q ' + g.cpx + ',' + g.cpy + ' ' + g.bx + ',' + g.by,
      fill: 'none', stroke: 'url(#edgeGrad' + i + ')', 'stroke-width': e.weight, 'stroke-linecap': 'round', opacity: 0
    });
    svg.appendChild(path);
    return path;
  });

  function render(T) {
    stage.style.opacity = 1 - cl((T - (TOTAL - .8)) / .65, 0, 1);

    var active = null;
    CAUSES.forEach(function (c) { if (T >= CUES[c.cue] && T < endOf(c.cue)) active = c; });

    var resolved = tw(T, CUES.Cierre + .1, CUES.Cierre + 1.0) * (1 - cl((T - (TOTAL - .9)) / .7, 0, 1));
    spokePaths.forEach(function (path) { path.setAttribute('opacity', resolved); });

    net.style.transform = 'scale(' + (1 + .012 * Math.sin((T / TOTAL) * Math.PI * 2)) + ')';

    ORDER.forEach(function (id, i) {
      var ap = tw(T, .2 + i * .15, 1.0 + i * .15, eBack);
      var hot = 0;
      if (active && active.nodes[id]) hot = tw(T, CUES[active.cue] + .9, CUES[active.cue] + 1.6) * (1 - cl((T - (endOf(active.cue) - .6)) / .5, 0, 1));
      var effectiveHot = Math.max(hot, resolved);
      var n = nodeEls[id];
      n.el.style.opacity = ap;
      n.el.style.transform = 'scale(' + ((.62 + .38 * ap) * (1 + .05 * effectiveHot)) + ')';
      n.ball.style.background = mixHex('#FFFFFF', '#FBE8DF', effectiveHot);
      n.ball.style.borderColor = mixHex('#ECECEB', '#E4603B', effectiveHot);
      n.ball.style.boxShadow = effectiveHot > .04 ? '0 6px 16px rgba(30,30,31,.08)' : 'none';
    });

    EDGES.forEach(function (e, i) {
      var d = tw(T, 1.0 + i * .06, 2.1 + i * .06, eIO);
      var cs = CUES[CAUSE_OF[e.id].cue];
      var p = tw(T, cs + 1.0, cs + 1.9);
      var el = edgeEls[i], g = e.g;
      if (p < .004) {
        el.whole.setAttribute('d', 'M ' + g.ax + ',' + g.ay + ' Q ' + g.cpx + ',' + g.cpy + ' ' + g.bx + ',' + g.by);
        el.whole.setAttribute('opacity', d > 0 ? 1 : 0);
        el.whole.setAttribute('stroke-dashoffset', g.len * (1 - d));
        var pu = (T * .19 + e.seed) % 1;
        var dotPt = quadPt(g.ax, g.ay, g.cpx, g.cpy, g.bx, g.by, pu);
        el.dot.setAttribute('cx', dotPt.x);
        el.dot.setAttribute('cy', dotPt.y);
        el.dot.setAttribute('opacity', d > .995 ? .55 * Math.sin(Math.PI * pu) : 0);
        [el.s1, el.s2, el.ghost, el.c1, el.c2, el.ring].forEach(function (x) { x.setAttribute('opacity', 0); });
        return;
      }
      el.whole.setAttribute('opacity', 0); el.dot.setAttribute('opacity', 0);
      var tGap = cl(p * .09, 0, .11);
      var split1 = quadSplit(g.ax, g.ay, g.cpx, g.cpy, g.bx, g.by, .5 - tGap);
      var split2 = quadSplit(g.ax, g.ay, g.cpx, g.cpy, g.bx, g.by, .5 + tGap);
      var f1 = split1.first, f2 = split2.second;
      var flash = 1 - cl((T - (cs + 1.0)) / .85, 0, 1);
      el.s1.setAttribute('d', 'M ' + f1.p0x + ',' + f1.p0y + ' Q ' + f1.cpx + ',' + f1.cpy + ' ' + f1.p1x + ',' + f1.p1y);
      el.s2.setAttribute('d', 'M ' + f2.p0x + ',' + f2.p0y + ' Q ' + f2.cpx + ',' + f2.cpy + ' ' + f2.p1x + ',' + f2.p1y);
      el.s1.setAttribute('opacity', 1); el.s2.setAttribute('opacity', 1);
      el.ghost.setAttribute('x1', f1.p1x); el.ghost.setAttribute('y1', f1.p1y);
      el.ghost.setAttribute('x2', f2.p0x); el.ghost.setAttribute('y2', f2.p0y); el.ghost.setAttribute('opacity', 1);
      el.c1.setAttribute('cx', f1.p1x); el.c1.setAttribute('cy', f1.p1y); el.c1.setAttribute('opacity', .28 + .6 * flash);
      el.c2.setAttribute('cx', f2.p0x); el.c2.setAttribute('cy', f2.p0y); el.c2.setAttribute('opacity', .28 + .6 * flash);
      var midPt = quadPt(g.ax, g.ay, g.cpx, g.cpy, g.bx, g.by, .5);
      el.ring.setAttribute('cx', midPt.x); el.ring.setAttribute('cy', midPt.y);
      el.ring.setAttribute('r', 10 + 36 * (1 - flash)); el.ring.setAttribute('opacity', .5 * flash);
    });

    if (resolved > .01) {
      var fadeMul = 1 - resolved;
      edgeEls.forEach(function (el) {
        [el.whole, el.dot, el.s1, el.s2, el.ghost, el.c1, el.c2, el.ring].forEach(function (x) {
          var cur = parseFloat(x.getAttribute('opacity') || '0');
          x.setAttribute('opacity', cur * fadeMul);
        });
      });
    }

    if (active) {
      card.classList.add('sysx-active');
      if (card.dataset.cue !== active.cue) {
        card.dataset.cue = active.cue;
        card.querySelector('.sysx-num').textContent = active.n;
        card.querySelector('.sysx-title').textContent = active.title;
        card.querySelector('.sysx-desc').textContent = active.desc;
      }
    } else { card.classList.remove('sysx-active'); }
  }

  var CROP = { x: 72, y: 16, w: 1256, h: 1168 };
  function fit() {
    var s = root.clientWidth / CROP.w;
    stage.style.transform = 'scale(' + s + ') translate(' + (-CROP.x) + 'px,' + (-CROP.y) + 'px)';
  }
  fit();
  if (window.ResizeObserver) new ResizeObserver(fit).observe(root); else window.addEventListener('resize', fit);

  var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduceMotion) { render(CUES.Cierre + 2); return; }

  var clock = 0, prev = null, visible = true;
  if (window.IntersectionObserver) new IntersectionObserver(function (en) { visible = en[0].isIntersecting; }).observe(root);
  function frame(ts) {
    if (prev === null) prev = ts;
    var dt = Math.min(.1, (ts - prev) / 1000); prev = ts;
    if (visible) { clock = (clock + dt) % TOTAL; render(clock); }
    requestAnimationFrame(frame);
  }
  requestAnimationFrame(frame);
})();
</script>

<script define:vars={{ WEBHOOK_URL }}>
  /* Envío real del formulario: POST a n8n con el lead + las 15 respuestas del
     quiz. El evento de conversión y la confirmación solo se muestran si el
     webhook responde OK; si falla, se muestra #form-error y se reactiva el botón. */
  (function () {
    var form = document.getElementById('lead-form');
    if (!form) return;

    var header = document.getElementById('quiz-form-header');
    var fields = document.getElementById('form-fields');
    var trustRow = document.getElementById('quiz-trust-row');
    var confirmBox = document.getElementById('confirm');
    var errorBox = document.getElementById('form-error');
    var noticeBox = document.getElementById('form-notice');
    var submitBtn = form.querySelector('.btn-primary');
    var submitLabel = submitBtn.textContent;

    function resetButton() {
      submitBtn.disabled = false;
      submitBtn.textContent = submitLabel;
    }

    form.addEventListener('submit', async function (event) {
      event.preventDefault();
      errorBox.style.display = 'none';
      noticeBox.style.display = 'none';
      submitBtn.disabled = true;
      submitBtn.textContent = 'Enviando…';

      var payload = {
        nombre: form.nombre.value.trim(),
        email: form.email.value.trim(),
        telefono: form.telefono.value.trim(),
        empresa: form.empresa.value.trim(),
        website: form.website.value,
        respuestas: (window.quizAnswers || []).map(Number),
      };

      try {
        var res = await fetch(WEBHOOK_URL, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        var data = await res.json().catch(function () { return {}; });

        if (res.ok) {
          if (typeof window.fbq === 'function') {
            window.fbq('track', 'Lead', { content_name: 'checklist_costuras_descarga' });
          }
          header.style.display = 'none';
          fields.style.display = 'none';
          if (trustRow) trustRow.style.display = 'none';
          confirmBox.style.display = 'block';
          confirmBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
          return;
        }

        // Lead ya registrado en un envío reciente: no es un error, solo aviso.
        if (res.status === 429 || data.code === 'RECENT_SUBMISSION') {
          noticeBox.style.display = 'block';
          resetButton();
          return;
        }

        throw new Error('Webhook respondió ' + res.status);
      } catch (err) {
        errorBox.style.display = 'block';
        resetButton();
      }
    });
  })();
</script>

</body>
