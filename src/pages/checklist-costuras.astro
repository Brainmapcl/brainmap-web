---
// Landing standalone del lead magnet "Checklist de Diagnóstico de Quiebres".
// A propósito NO usa src/layouts/Layout.astro: ese trae el <nav> del home, que
// no debe aparecer en una landing de conversión aislada. Se repiten aquí a mano
// sólo las piezas de Layout.astro que sí necesita: los 6 archivos de tokens del
// design system (_ds), Phosphor Icons, el Meta Pixel y el snippet de GA4.
import { DS_BASE } from '../lib/constants';

// Endpoint del webhook de n8n (workflow "Recepción y Entrega"). Recibe el lead
// + las 15 respuestas del quiz, calcula puntaje/tier, genera el informe PDF y lo
// envía por correo. El envío real está al final del <body> (script define:vars).
const WEBHOOK_URL = 'https://brainmap-n8n2.onq6ef.easypanel.host/webhook/checklist-costuras';
---

<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Checklist de Diagnóstico de Costuras — Brainmap</title>
<meta name="description" content="Checklist gratuito de 15 preguntas para ubicar dónde tu empresa pierde clientes entre sistemas, antes de automatizar más. Para gerencias de CX y operaciones en Chile.">
<meta property="og:title" content="Checklist de Diagnóstico de Costuras — Brainmap">
<meta property="og:description" content="Dónde tu empresa pierde clientes entre sistemas, y cómo detectarlo antes de automatizar más. Descarga gratuita.">
<meta property="og:type" content="website">
<meta property="og:locale" content="es_CL">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24'%3E%3Crect width='24' height='24' rx='6' fill='%231E1E1F'/%3E%3Cpath d='M4 12h4l2-6 4 12 2-6h4' stroke='white' stroke-width='2' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">

<link rel="stylesheet" href={`${DS_BASE}/tokens/colors.css`} />
<link rel="stylesheet" href={`${DS_BASE}/tokens/typography.css`} />
<link rel="stylesheet" href={`${DS_BASE}/tokens/spacing.css`} />
<link rel="stylesheet" href={`${DS_BASE}/tokens/shadows.css`} />
<link rel="stylesheet" href={`${DS_BASE}/tokens/radii.css`} />
<link rel="stylesheet" href={`${DS_BASE}/tokens/motion.css`} />

<link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/regular/style.css" />
<link rel="stylesheet" href="https://unpkg.com/@phosphor-icons/web@2.1.1/src/fill/style.css" />

<style is:global>
*,*::before,*::after{box-sizing:border-box}
html{overflow-x:hidden}
body{
  margin:0;background:var(--color-canvas);font-family:var(--font-body);color:var(--color-text-primary);
  -webkit-font-smoothing:antialiased;overflow-x:hidden;max-width:100vw;position:relative;
}
/* atmósfera ambiental — hilos de costura muy sutiles cruzando toda la página,
   la metáfora de marca hecha textura, no solo palabra */
body::before{
  content:'';position:fixed;inset:0;z-index:0;pointer-events:none;opacity:.5;
  background-image:
    repeating-linear-gradient(115deg, transparent 0 26px, rgba(228,96,59,.05) 26px 27px, transparent 27px 54px),
    repeating-linear-gradient(25deg, transparent 0 38px, rgba(30,30,31,.025) 38px 39px, transparent 39px 76px);
}
.wrap, .seam, footer{position:relative;z-index:1}
img,video{max-width:100%;display:block}
.wrap{max-width:1100px;margin:0 auto;padding:0 32px}
@media (max-width:720px){.wrap{padding:0 20px}}

.seam{position:relative; height:64px; margin:0 auto; max-width:1100px; display:flex; align-items:center; justify-content:center;}
.seam svg{width:100%;height:24px; overflow:visible}
.seam .seam-line{stroke-dasharray:10 8; transform-box:fill-box; transform-origin:0% 50%; transform:scaleX(1);}
.seam .seam-label{position:absolute; background:var(--color-canvas); padding:0 18px; font-family:var(--font-mono); font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--color-text-muted);}

.eyebrow{display:inline-flex; align-items:center; gap:8px; font-family:var(--font-body); font-size:11px; font-weight:600; letter-spacing:.08em; text-transform:uppercase; color:var(--color-accent-intense); background:var(--color-accent-subtle); border:1px solid var(--color-border-accent); padding:5px 14px; border-radius:var(--radius-full);}

.hero{padding:76px 0 24px; position:relative}
.hero-copy{max-width:640px; margin:0 auto; text-align:center; position:relative; z-index:1}
.hero-copy .stat-row{justify-content:center}
.hero-copy .btn-hero{margin-left:auto; margin-right:auto}
.showcase{padding:16px 0 40px; position:relative}
.showcase-frame{position:relative; padding:20px}
.showcase-frame::before, .showcase-frame::after,
.showcase-frame .corner-tr, .showcase-frame .corner-bl{
  content:''; position:absolute; width:34px; height:34px; pointer-events:none;
}
.showcase-frame::before{ /* top-left */
  top:0; left:0; border-top:2.5px solid var(--color-accent-intense); border-left:2.5px solid var(--color-accent-intense);
}
.showcase-frame::after{ /* bottom-right */
  bottom:0; right:0; border-bottom:2.5px solid var(--color-accent-intense); border-right:2.5px solid var(--color-accent-intense);
}
.showcase-frame .corner-tr{ top:0; right:0; border-top:2.5px solid var(--color-accent-intense); border-right:2.5px solid var(--color-accent-intense); }
.showcase-frame .corner-bl{ bottom:0; left:0; border-bottom:2.5px solid var(--color-accent-intense); border-left:2.5px solid var(--color-accent-intense); }
.showcase .sysx-wrap{position:relative; z-index:1}
.logo{display:flex;align-items:center;gap:10px;margin-bottom:56px}
.logo-mark-img{width:34px;height:34px;object-fit:contain;display:block}
.logo-word{font-family:var(--font-display);font-weight:600;font-size:19px;letter-spacing:-0.02em}
h1{font-family:var(--font-display); font-weight:600; letter-spacing:-0.02em; font-size:clamp(34px,4.4vw,52px); line-height:1.08; margin:20px 0 22px;}
h1 em{font-style:italic; color:var(--color-text-accent)}
.hero-sub{font-size:17px; line-height:1.6; color:var(--color-text-secondary); max-width:460px; margin:0 auto 32px}
.btn-hero{display:inline-flex; align-items:center; gap:8px; font-family:var(--font-body); font-weight:600; font-size:15px; color:#fff; background:var(--color-text-primary); border-radius:var(--radius-full); padding:15px 30px; text-decoration:none; box-shadow:0 4px 20px rgba(30,30,31,.18); margin-bottom:34px; transition:transform .18s ease, box-shadow .18s ease;}
.btn-hero:hover{transform:translateY(-2px); box-shadow:0 8px 28px rgba(30,30,31,.24)}
.btn-arrow{transition:transform .2s ease; font-size:16px}
.btn-hero:hover .btn-arrow{transform:translateX(4px)}
.stat-row{display:flex; gap:28px; margin-top:8px; flex-wrap:wrap; justify-content:center}
.stat{display:flex; flex-direction:column; align-items:center; gap:12px; flex:1 1 0; min-width:150px; max-width:220px; text-align:center}
.stat b{font-family:var(--font-display); font-size:clamp(30px,4vw,38px); color:var(--color-text-accent); line-height:1}
.stat span{font-size:13.5px; color:var(--color-text-muted); line-height:1.4}

.sysx-wrap{max-width:940px; margin:0 auto}
.sysx-row{display:flex; align-items:stretch; gap:0}
@media (max-width:720px){.sysx-row{flex-direction:column}}
.sysx { position: relative; flex:1 1 auto; min-width:0; aspect-ratio: 1256 / 1168; overflow: hidden; }
.sysx-side{
  flex:0 0 260px; display:flex; align-items:center; justify-content:center; padding:24px;
  border-left:1px solid var(--color-border); background:var(--color-canvas);
}
@media (max-width:720px){.sysx-side{flex-basis:auto; border-left:none; border-top:1px solid var(--color-border)}}
.sysx-stage { position: absolute; left: 0; top: 0; width: 1400px; height: 1200px; transform-origin: 0 0; }
.sysx-glow { position: absolute; inset: 0; background: radial-gradient(900px 760px at 50% 46%, rgba(255,255,255,.95), rgba(251,251,250,0) 72%); }
.sysx-net { position: absolute; inset: 0; transform-origin: 50% 50%; }
.sysx-node { position: absolute; transform-origin: 50% 50%; }
.sysx-ball { position: absolute; inset: 0; border-radius: 50%;
  background: var(--color-canvas-elevated); border: 1.8px solid var(--color-border);
  transition: background-color .25s ease, border-color .25s ease; }
.sysx-label { position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%); width: 250px;
  text-align: center; white-space: nowrap; font-family: var(--font-body);
  font-weight: 700; font-size: 28px; letter-spacing: -.015em; line-height: 1.1; color: var(--color-text-primary); }
.sysx-card { position:relative; width: 100%; min-height:130px; font-family: var(--font-body); }
.sysx-num { font-family: var(--font-mono); font-size: 12px; letter-spacing: .14em; color: var(--color-accent-intense); }
.sysx-title { margin-top: 8px; font-size: 19px; font-weight: 700; line-height: 1.18; letter-spacing: -.015em; color: var(--color-text-primary); }
.sysx-desc { margin-top: 8px; font-size: 13.5px; line-height: 1.5; color: var(--color-text-muted); }
.sysx-idle-label{
  position:absolute; inset:0; display:flex; align-items:center; justify-content:center; text-align:center;
  font-family:var(--font-mono); font-size:11px; letter-spacing:.1em; text-transform:uppercase; color:var(--color-text-muted);
  opacity:1; transition:opacity .3s ease;
}
.sysx-active-content{position:absolute; inset:0; opacity:0; transition:opacity .3s ease}
.sysx-card.sysx-active .sysx-idle-label{opacity:0}
.sysx-card.sysx-active .sysx-active-content{opacity:1}
@media (max-width:720px){ .sysx-side{padding:20px} }

.costuras{padding:56px 0 64px}
.costuras-head{max-width:640px;margin:0 auto 40px;text-align:center}
h2{font-family:var(--font-display);font-weight:600;font-size:clamp(26px,3vw,36px);letter-spacing:-0.02em;line-height:1.15;margin:14px 0 12px}
.costuras-head p{color:var(--color-text-secondary);font-size:15px;line-height:1.6;margin:0}
.costuras-list{display:grid;grid-template-columns:repeat(5,1fr);gap:14px; position:relative}
.costuras-list::before{
  content:''; position:absolute; left:2%; right:2%; top:38px; height:0; z-index:0;
  border-top:2px dashed var(--color-border-accent);
}
@media (max-width:900px){.costuras-list{grid-template-columns:repeat(2,1fr)} .costuras-list::before{display:none}}
@media (max-width:520px){.costuras-list{grid-template-columns:1fr}}
.costura-item{
  background:var(--color-canvas-elevated); border:1px solid var(--color-border); border-radius:var(--radius-lg);
  padding:18px 16px; position:relative; z-index:1; transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease;
}
.costura-item:hover{transform:translateY(-4px); box-shadow:0 14px 28px rgba(30,30,31,.10); border-color:var(--color-border-accent)}
.costura-item:nth-child(even):hover{transform:translateY(18px)}
.costura-item:nth-child(even){transform:translateY(22px)}
@media (max-width:900px){.costura-item:nth-child(even){transform:none}}
.costura-item .n{
  display:inline-flex; align-items:center; justify-content:center; width:22px; height:22px;
  background:var(--color-canvas); border:1px solid var(--color-border-accent); border-radius:50%;
}
.costura-item .n{font-family:var(--font-mono);font-size:10px;color:var(--color-accent-intense);letter-spacing:.1em}
.costura-item h4{font-family:var(--font-body);font-weight:600;font-size:14px;margin:8px 0 4px}
.costura-item p{font-size:12.5px;color:var(--color-text-muted);line-height:1.5;margin:0}

.quiz-section{padding:0 0 88px}
.quiz-card{background:var(--color-canvas-elevated); border-radius:var(--radius-2xl); box-shadow:var(--shadow-lg); padding:44px; max-width:560px; margin:0 auto;}
@media (max-width:600px){.quiz-card{padding:28px}}
.quiz-view h2{text-align:center;font-size:26px;margin-top:8px}
.quiz-view .sub{text-align:center;color:var(--color-text-secondary);font-size:14.5px;line-height:1.55;margin:0 0 28px}
#quiz-intro{text-align:center}
#quiz-intro .sub{margin-bottom:28px}

.quiz-progress-row{display:flex; justify-content:space-between; align-items:center; margin-bottom:14px}
.quiz-progress-label{font-size:12.5px; font-weight:600; color:var(--color-text-secondary)}
.quiz-progress-cat{
  display:inline-flex; align-items:center; gap:5px;
  font-family:var(--font-mono); font-size:11px; letter-spacing:.08em; text-transform:uppercase;
  color:var(--color-accent-intense); background:var(--color-accent-subtle); border:1px solid var(--color-border-accent);
  padding:5px 14px; border-radius:var(--radius-full); font-weight:600;
}
.quiz-progress-cat i{font-size:15.5px}
.quiz-progress-track{height:5px; background:var(--color-border); border-radius:var(--radius-full); overflow:hidden; margin-bottom:32px}
.quiz-progress-fill{height:100%; width:0%; background:var(--color-accent-intense); border-radius:var(--radius-full); transition:width .35s ease}

.quiz-question{font-family:var(--font-display); font-size:22px; font-weight:600; line-height:1.35; color:var(--color-text-primary); margin:0 0 28px; min-height:88px}

.quiz-answers{display:flex; flex-direction:column; gap:10px; margin-bottom:18px}
.quiz-answer-btn{
  display:flex; align-items:center; justify-content:flex-start; gap:10px;
  font-family:var(--font-body); font-size:15px; font-weight:600; color:var(--color-text-primary);
  background:var(--color-canvas); border:1.5px solid var(--color-border); border-radius:var(--radius-input);
  padding:15px 18px; cursor:pointer; transition:all .15s ease; width:100%; text-align:left;
}
.quiz-answer-btn:hover{border-color:var(--color-accent-intense); background:var(--color-accent-subtle)}
.quiz-answer-icon{font-size:17px}
.quiz-back{display:block; margin:0 auto; background:none; border:none; color:var(--color-text-muted); font-size:12.5px; font-family:var(--font-body); cursor:pointer; padding:6px}
.quiz-back:hover{color:var(--color-text-secondary)}
.quiz-back:disabled{visibility:hidden}

.quiz-score{font-family:var(--font-display); font-size:56px; font-weight:700; color:var(--color-accent-intense); margin:18px 0 4px; line-height:1}
.quiz-tier{font-family:var(--font-body); font-size:16px; font-weight:700; color:var(--color-text-primary); margin-bottom:10px}
.quiz-tier-desc{font-size:14.5px; color:var(--color-text-secondary); line-height:1.65; max-width:440px; margin:0 auto 24px; text-align:left}
.quiz-teaser{background:var(--color-canvas); border:1px solid var(--color-border); border-radius:var(--radius-lg); padding:18px 20px; margin-bottom:24px}
.quiz-teaser-title{font-size:13px; font-weight:600; color:var(--color-text-primary); margin:0 0 10px}
.quiz-teaser-list{margin:0; padding:0; list-style:none; display:flex; flex-direction:column; gap:8px}
.quiz-teaser-list li{font-size:13.5px; color:var(--color-text-secondary); line-height:1.5; display:flex; align-items:flex-start; gap:8px}
.quiz-teaser-list li i{color:var(--color-accent-intense); font-size:15px; flex-shrink:0; margin-top:1px}

.credibility-line{
  display:flex; align-items:center; justify-content:center; gap:10px; max-width:520px; margin:0 auto 24px;
  font-size:12.5px; color:var(--color-text-muted); line-height:1.4; text-align:center;
}
.credibility-avatar{
  flex-shrink:0; width:28px; height:28px; border-radius:50%; object-fit:contain;
  background:var(--color-canvas-elevated); padding:5px; box-shadow:0 0 0 1px var(--color-border);
}

.reveal{opacity:0; transform:translateY(18px); transition:opacity .6s ease, transform .6s ease}
.reveal.in-view{opacity:1; transform:none}
.costuras-list .reveal:nth-child(1){transition-delay:.05s}
.costuras-list .reveal:nth-child(2){transition-delay:.12s}
.costuras-list .reveal:nth-child(3){transition-delay:.19s}
.costuras-list .reveal:nth-child(4){transition-delay:.26s}
.costuras-list .reveal:nth-child(5){transition-delay:.33s}
@media (prefers-reduced-motion: reduce){.reveal{opacity:1; transform:none; transition:none}}
.field{display:flex;flex-direction:column;gap:6px;margin-bottom:16px}
.field label{font-size:12.5px;font-weight:500;color:var(--color-text-secondary)}
.field label .opt{font-weight:400;color:var(--color-text-muted)}
.privacy-note{font-size:11.5px;color:var(--color-text-muted);text-align:center;line-height:1.5;margin:12px 0 0}
.field input{font-family:var(--font-body);font-size:15px;color:var(--color-text-primary);background:var(--color-canvas);border:1.5px solid transparent;border-radius:var(--radius-input);padding:13px 16px;outline:none;box-shadow:var(--shadow-neumorph-inset);}
.field input:focus{border-color:var(--color-accent)}
.hp-field{position:absolute; left:-9999px; top:-9999px; width:1px; height:1px; opacity:0; overflow:hidden; pointer-events:none;}
.btn-primary{width:100%;font-family:var(--font-body);font-weight:600;font-size:15px;color:#fff;background:var(--color-text-primary);border:none;border-radius:var(--radius-full);padding:16px;cursor:pointer;box-shadow:0 4px 20px rgba(30,30,31,.18);margin-top:6px;transition:transform .18s ease, box-shadow .18s ease;}
.btn-primary:hover{transform:translateY(-2px); box-shadow:0 8px 26px rgba(30,30,31,.24)}
.trust-row{display:flex;justify-content:center;gap:18px;margin-top:18px;flex-wrap:wrap}
.trust-row span{font-size:11.5px;color:var(--color-text-muted);display:flex;align-items:center;gap:6px}
.trust-row .dot{width:5px;height:5px;border-radius:50%;background:var(--color-accent)}
.form-error{display:none; background:var(--color-error-subtle); color:var(--color-error); border:1px solid var(--color-error); border-radius:var(--radius-md); padding:12px 16px; font-size:13.5px; line-height:1.5; margin:0 0 16px; text-align:center;}
.form-notice{display:none; background:var(--color-accent-subtle); color:var(--color-text-secondary); border:1px solid var(--color-border-accent); border-radius:var(--radius-md); padding:12px 16px; font-size:13.5px; line-height:1.5; margin:0 0 16px; text-align:center;}
footer{padding:28px 0;border-top:1px solid var(--color-border);text-align:center}
footer p{font-size:12px;color:var(--color-text-muted);margin:0}

@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
.stagger{opacity:0; animation:rise .7s ease forwards}
.stagger:nth-child(1){animation-delay:.05s}
.stagger:nth-child(2){animation-delay:.16s}
.stagger:nth-child(3){animation-delay:.27s}
.stagger:nth-child(4){animation-delay:.38s}
.stagger:nth-child(5){animation-delay:.49s}
@media (prefers-reduced-motion: reduce){.stagger{opacity:1; animation:none}}

/* accesibilidad — foco visible con teclado, feedback táctil al hacer clic */
.btn-hero:focus-visible, .btn-primary:focus-visible, .quiz-answer-btn:focus-visible,
.quiz-back:focus-visible, .field input:focus-visible{
  outline:2px solid var(--color-accent-intense); outline-offset:2px;
}
.btn-hero:active{transform:translateY(0) scale(.98)}
.btn-primary:active{transform:translateY(0) scale(.98)}
.quiz-answer-btn:active{transform:scale(.97)}
.costura-item:focus-within{outline:2px solid var(--color-accent-intense); outline-offset:2px}
</style>

